static void dsaDemonstration(Bank *bank)
{
    int choice;
    Transaction t;

    do {
        printf("\n---------- DSA DEMONSTRATION ----------\n");
        printf("1. Linked List - Display accounts\n");
        printf("2. Queue       - Display waiting customers\n");
        printf("3. Stack       - Display recent transactions\n");
        printf("4. Searching   - Search account\n");
        printf("5. Sorting     - Sort accounts by balance\n");
        printf("6. Back\n");
        choice = readInt("Enter choice: ", 1, 6);

        switch (choice) {
        case 1:
            printf("\nLinked list: each account is a node pointing to the next one.\n");
            displayAccounts(bank);
            break;
        case 2:
            printf("\nQueue (FIFO): the customer who arrived first is served first.\n");
            displayQueue(&bank->queue);
            break;
        case 3:
            printf("\nStack (LIFO): the newest transaction is on top. Last 5 transactions:\n");
            displayTransactions(&bank->txStack, 0, 5);
            if (popTransaction(&bank->txStack, &t)) {
                printf("\nPOP  -> removed top: Transaction %d (%s, Rs %.2f)\n", t.id, t.type, t.amount);
                pushTransactionRecord(&bank->txStack, &t);
                printf("PUSH -> put it back on top (history is unchanged).\n");
            }
            break;
        case 4:
            searchAccount(bank);
            break;
        case 5:
            if (sortAccounts(bank, SORT_BY_BALANCE, 1)) {
                printf("\nAccounts sorted by balance (ascending) using Bubble Sort:\n");
                displayAccounts(bank);
                saveAccounts(bank);
            } else {
                printf("No accounts to sort.\n");
            }
            break;
        }
    } while (choice != 6);
}

