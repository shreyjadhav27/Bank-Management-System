/* ====================================================== */
/*               STACK OPERATIONS (TRANSACTIONS)           */
/* ====================================================== */

/* PUSH an existing transaction record onto the stack. O(1)
 * The new node becomes the top. */
static int pushTransactionRecord(TxStack *s, const Transaction *t)
{
    TxNode *node = (TxNode *)malloc(sizeof(TxNode));
    if (node == NULL) {
        printf("Error: out of memory.\n");
        return 0;
    }
    node->data = *t;
    node->next = s->top;
    s->top = node;
    s->count++;
    return 1;
}

/* Build a new transaction (with ID and time) and PUSH it. O(1) */
static int pushTransaction(TxStack *s, int accNo, const char *type,
                           double amount, double balanceAfter, int otherAcc)
{
    Transaction t;
    memset(&t, 0, sizeof t);
    t.id = s->nextId++;
    t.accNo = accNo;
    snprintf(t.type, sizeof t.type, "%s", type);
    t.amount = amount;
    getCurrentTime(t.dateTime, sizeof t.dateTime);
    t.balanceAfter = balanceAfter;
    t.otherAcc = otherAcc;
    return pushTransactionRecord(s, &t);
}

/* POP the newest transaction (LIFO). O(1)
 * Returns 1 and copies the record into *out, or 0 if the stack is empty. */
static int popTransaction(TxStack *s, Transaction *out)
{
    TxNode *node;
    if (s->top == NULL) {
        return 0;
    }
    node = s->top;
    *out = node->data;
    s->top = node->next;
    s->count--;
    free(node);
    return 1;
}

/* Display transactions from the top of the stack (newest first).
 * accNo = 0 shows every account; limit = 0 shows all matching records. */
static void displayTransactions(const TxStack *s, int accNo, int limit)
{
    const TxNode *cur = s->top;
    int shown = 0;
    char other[12];

    printf("%-6s %-8s %-17s %12s %-19s %12s %-8s\n",
           "ID", "Account", "Type", "Amount", "Date & Time", "Balance", "Other A/c");
    printf("----------------------------------------------------------------------------------------\n");
    while (cur != NULL) {
        if (accNo == 0 || cur->data.accNo == accNo) {
            if (cur->data.otherAcc > 0) {
                snprintf(other, sizeof other, "%d", cur->data.otherAcc);
            } else {
                snprintf(other, sizeof other, "-");
            }
            printf("%-6d %-8d %-17s %12.2f %-19s %12.2f %-8s\n",
                   cur->data.id, cur->data.accNo, cur->data.type,
                   cur->data.amount, cur->data.dateTime,
                   cur->data.balanceAfter, other);
            shown++;
            if (limit > 0 && shown >= limit) {
                break;
            }
        }
        cur = cur->next;
    }
    if (shown == 0) {
        printf("No transactions found.\n");
    }
}

/* Free every node of the stack */
static void freeStack(TxStack *s)
{
    TxNode *cur = s->top;
    TxNode *nextNode;
    while (cur != NULL) {
        nextNode = cur->next;
        free(cur);
        cur = nextNode;
    }
    s->top = NULL;
    s->count = 0;
}

/* ====================================================== */
/*               QUEUE OPERATIONS (WAITING CUSTOMERS)      */
/* ====================================================== */

/* ENQUEUE: add a customer at the REAR of the queue. O(1) */
static int addToQueue(Queue *q, const char *name, const char *service)
{
    QueueNode *node = (QueueNode *)malloc(sizeof(QueueNode));
    if (node == NULL) {
        printf("Error: out of memory.\n");
        return 0;
    }
    node->token = q->nextToken++;
    snprintf(node->name, sizeof node->name, "%s", name);
    snprintf(node->service, sizeof node->service, "%s", service);
    node->next = NULL;

    if (q->rear == NULL) {
        q->front = node; /* queue was empty */
        q->rear = node;
    } else {
        q->rear->next = node;
        q->rear = node;
    }
    q->size++;
    printf("Customer added to queue. Token number: %d\n", node->token);
    return 1;
}

/* DEQUEUE: serve the customer at the FRONT (first come, first served). O(1) */
static int serveQueue(Queue *q)
{
    QueueNode *node;
    if (q->front == NULL) {
        printf("The waiting queue is empty. No customer to serve.\n");
        return 0;
    }
    node = q->front;
    printf("Now serving -> Token %d | %s | Service: %s\n",
           node->token, node->name, node->service);
    q->front = node->next;
    if (q->front == NULL) {
        q->rear = NULL; /* queue became empty */
    }
    q->size--;
    free(node);
    return 1;
}

/* Display the waiting queue from front to rear */
static void displayQueue(const Queue *q)
{
    const QueueNode *cur = q->front;
    if (cur == NULL) {
        printf("The waiting queue is empty.\n");
        return;
    }
    printf("%-8s %-25s %-25s\n", "Token", "Customer name", "Service");
    printf("------------------------------------------------------------\n");
    while (cur != NULL) {
        printf("%-8d %-25.25s %-25.25s\n", cur->token, cur->name, cur->service);
        cur = cur->next;
    }
    printf("Customers waiting: %d\n", q->size);
}

/* Free every node of the queue */
static void freeQueue(Queue *q)
{
    QueueNode *cur = q->front;
    QueueNode *nextNode;
    while (cur != NULL) {
        nextNode = cur->next;
        free(cur);
        cur = nextNode;
    }
    q->front = NULL;
    q->rear = NULL;
    q->size = 0;
}

/* ====================================================== */
/*                      FILE HANDLING                      */
/* ====================================================== */

/* Write all accounts (linked list) to accounts.dat. Returns 1 on success. */
static int saveAccounts(const Bank *bank)
{
    FILE *fp = fopen(ACCOUNTS_FILE, "wb");
    const AccountNode *cur;

    if (fp == NULL) {
        printf("Error: cannot open %s for writing.\n", ACCOUNTS_FILE);
        return 0;
    }
    for (cur = bank->head; cur != NULL; cur = cur->next) {
        if (fwrite(&cur->data, sizeof(Account), 1, fp) != 1) {
            printf("Error: failed while writing %s.\n", ACCOUNTS_FILE);
            fclose(fp);
            return 0;
        }
    }
    fclose(fp);
    return 1;
}

/* Read accounts.dat at startup and rebuild the linked list. */
static int loadAccounts(Bank *bank)
{
    FILE *fp = fopen(ACCOUNTS_FILE, "rb");
    Account acc;
    int maxAccNo = FIRST_ACC_NO - 1;

    if (fp == NULL) {
        printf("No %s found. Starting with no accounts (first run).\n", ACCOUNTS_FILE);
        return 0;
    }
    while (fread(&acc, sizeof(Account), 1, fp) == 1) {
        /* make sure text fields are terminated even if the file is damaged */
        acc.name[NAME_LEN - 1] = '\0';
        acc.phone[PHONE_LEN - 1] = '\0';
        acc.address[ADDR_LEN - 1] = '\0';
        acc.type[TYPE_LEN - 1] = '\0';
        acc.pin[PIN_LEN - 1] = '\0';
        if (insertAccount(bank, &acc) != NULL && acc.accNo > maxAccNo) {
            maxAccNo = acc.accNo;
        }
    }
    fclose(fp);
    bank->nextAccNo = maxAccNo + 1;
    return 1;
}

/* Write the whole transaction stack to transactions.dat.
 * The file stores OLDEST first, so we copy the stack into an array
 * from the back (top = newest goes to the last position). */
static int saveTransactions(const TxStack *s)
{
    FILE *fp;
    Transaction *arr = NULL;
    const TxNode *cur;
    int i, ok = 1;

    if (s->count > 0) {
        arr = (Transaction *)malloc((size_t)s->count * sizeof(Transaction));
        if (arr == NULL) {
            printf("Error: out of memory while saving transactions.\n");
            return 0;
        }
        i = s->count - 1;
        for (cur = s->top; cur != NULL && i >= 0; cur = cur->next) {
            arr[i--] = cur->data;
        }
    }
    fp = fopen(TRANSACTIONS_FILE, "wb");
    if (fp == NULL) {
        printf("Error: cannot open %s for writing.\n", TRANSACTIONS_FILE);
        free(arr);
        return 0;
    }
    if (s->count > 0 && fwrite(arr, sizeof(Transaction), (size_t)s->count, fp) != (size_t)s->count) {
        printf("Error: failed while writing %s.\n", TRANSACTIONS_FILE);
        ok = 0;
    }
    fclose(fp);
    free(arr);
    return ok;
}

/* Read transactions.dat and push each record (oldest first),
 * so the newest transaction ends up on top of the stack. */
static int loadTransactions(TxStack *s)
{
    FILE *fp = fopen(TRANSACTIONS_FILE, "rb");
    Transaction t;
    int maxId = 0;

    if (fp == NULL) {
        printf("No %s found. Starting with empty history (first run).\n", TRANSACTIONS_FILE);
        return 0;
    }
    while (fread(&t, sizeof(Transaction), 1, fp) == 1) {
        t.type[TX_TYPE_LEN - 1] = '\0';
        t.dateTime[TIME_LEN - 1] = '\0';
        if (pushTransactionRecord(s, &t) && t.id > maxId) {
            maxId = t.id;
        }
    }
    fclose(fp);
    s->nextId = maxId + 1;
    return 1;
}

/* Save both files (called after every change so no data is lost) */
static void saveAll(const Bank *bank)
{
    saveAccounts(bank);
    saveTransactions(&bank->txStack);
}

/* ====================================================== */
/*                SEARCHING AND SORTING                    */
/* ====================================================== */

/* Case-insensitive string comparison (like strcmp) */
static int compareIgnoreCase(const char *a, const char *b)
{
    while (*a != '\0' && *b != '\0') {
        int ca = tolower((unsigned char)*a);
        int cb = tolower((unsigned char)*b);
        if (ca != cb) {
            return ca - cb;
        }
        a++;
        b++;
    }
    return tolower((unsigned char)*a) - tolower((unsigned char)*b);
}

/* Returns 1 if 'pattern' appears inside 'text' (ignoring case) */
static int containsIgnoreCase(const char *text, const char *pattern)
{
    size_t n = strlen(text), m = strlen(pattern), i, j;
    if (m == 0) {
        return 1;
    }
    for (i = 0; i + m <= n; i++) {
        j = 0;
        while (j < m && tolower((unsigned char)text[i + j]) == tolower((unsigned char)pattern[j])) {
            j++;
        }
        if (j == m) {
            return 1;
        }
    }
    return 0;
}

/* Compare two accounts by the chosen key. Negative: a < b, 0: equal, positive: a > b */
static int compareAccounts(const Account *a, const Account *b, int key)
{
    if (key == SORT_BY_ACCNO) {
        return a->accNo - b->accNo;
    }
    if (key == SORT_BY_NAME) {
        return compareIgnoreCase(a->name, b->name);
    }
    if (a->balance < b->balance) {
        return -1;
    }
    if (a->balance > b->balance) {
        return 1;
    }
    return 0;
}

/* Copy the addresses of all list nodes into an array of pointers.
 * Arrays allow direct access by index, which binary search and
 * sorting need. Caller must free() the returned array. */
static AccountNode **buildAccountArray(const Bank *bank, int *count)
{
    AccountNode *cur;
    AccountNode **arr;
    int n = 0, i = 0;

    for (cur = bank->head; cur != NULL; cur = cur->next) {
        n++;
    }
    *count = n;
    if (n == 0) {
        return NULL;
    }
    arr = (AccountNode **)malloc((size_t)n * sizeof(AccountNode *));
    if (arr == NULL) {
        printf("Error: out of memory.\n");
        *count = 0;
        return NULL;
    }
    for (cur = bank->head; cur != NULL; cur = cur->next) {
        arr[i++] = cur;
    }
    return arr;
}

/* BUBBLE SORT on an array of node pointers.
 * Repeatedly compare neighbours and swap them if out of order.
 * After each pass the largest (or smallest) item "bubbles" to the end.
 * Time: O(n^2) worst/average, O(n) best (already sorted, thanks to the
 * 'swapped' flag). Space: O(1) extra. It is a stable sort. */
static void sortPointerArray(AccountNode **arr, int n, int key, int ascending)
{
    int pass, j, swapped, cmp;
    AccountNode *temp;

    for (pass = 0; pass < n - 1; pass++) {
        swapped = 0;
        for (j = 0; j < n - 1 - pass; j++) {
            cmp = compareAccounts(&arr[j]->data, &arr[j + 1]->data, key);
            if ((ascending && cmp > 0) || (!ascending && cmp < 0)) {
                temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
                swapped = 1;
            }
        }
        if (!swapped) {
            break; /* no swaps in a full pass: already sorted */
        }
    }
}

/* Sort the accounts by key (ascending or descending) and re-link the
 * linked list in the new order. Returns 1 on success. */
static int sortAccounts(Bank *bank, int key, int ascending)
{
    int n, i;
    AccountNode **arr = buildAccountArray(bank, &n);

    if (arr == NULL) {
        return 0; /* no accounts (or no memory) */
    }
    sortPointerArray(arr, n, key, ascending);

    /* re-link the list using the sorted order */
    for (i = 0; i < n - 1; i++) {
        arr[i]->next = arr[i + 1];
    }
    arr[n - 1]->next = NULL;
    bank->head = arr[0];

    free(arr);
    return 1;
}

/* LINEAR SEARCH: check every node one by one for a name match.
 * Time: O(n). Works on unsorted data. Returns the number of matches. */
static int linearSearchByName(const Bank *bank, const char *name)
{
    const AccountNode *cur;
    int comparisons = 0, found = 0;

    for (cur = bank->head; cur != NULL; cur = cur->next) {
        comparisons++;
        if (containsIgnoreCase(cur->data.name, name)) {
            if (found == 0) {
                printAccountHeader();
            }
            printAccountRow(&cur->data);
            found++;
        }
    }
    if (found == 0) {
        printf("Result: no account found with name containing \"%s\".\n", name);
    }
    printf("[Linear search: %d comparison(s), %d match(es)]\n", comparisons, found);
    return found;
}

/* BINARY SEARCH: the array MUST be sorted by account number.
 * Each step halves the search range. Time: O(log n). */
static AccountNode *binarySearchAccount(AccountNode **arr, int n, int accNo, int *steps)
{
    int low = 0, high = n - 1, mid;

    *steps = 0;
    while (low <= high) {
        mid = low + (high - low) / 2;
        (*steps)++;
        if (arr[mid]->data.accNo == accNo) {
            return arr[mid];
        }
        if (arr[mid]->data.accNo < accNo) {
            low = mid + 1;  /* search right half */
        } else {
            high = mid - 1; /* search left half */
        }
    }
    return NULL;
}

/* Admin search menu: linear search by name OR binary search by account number */
static void searchAccount(Bank *bank)
{
    int choice, accNo, n, steps;
    char name[INPUT_LEN];
    AccountNode **arr;
    AccountNode *result;

    printf("\n--- Search Account ---\n");
    printf("1. Linear Search by customer name\n");
    printf("2. Binary Search by account number\n");
    printf("3. Back\n");
    choice = readInt("Enter choice: ", 1, 3);

    if (choice == 1) {
        readLine("Enter name (or part of a name): ", name, sizeof name);
        if (name[0] == '\0') {
            printf("Name cannot be empty.\n");
            return;
        }
        linearSearchByName(bank, name);
    } else if (choice == 2) {
        accNo = readInt("Enter account number: ", FIRST_ACC_NO, MAX_ACC_NO);
        arr = buildAccountArray(bank, &n);
        if (arr == NULL) {
            printf("No accounts available to search.\n");
            return;
        }
        /* Binary search needs sorted data, so sort by account number first */
        sortPointerArray(arr, n, SORT_BY_ACCNO, 1);
        result = binarySearchAccount(arr, n, accNo, &steps);
        if (result != NULL) {
            printf("Account found!\n");
            printAccountHeader();
            printAccountRow(&result->data);
        } else {
            printf("Result: account %d not found.\n", accNo);
        }
        printf("[Binary search on %d sorted account(s): %d step(s)]\n", n, steps);
        free(arr);
    }
}

