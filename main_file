static void initBank(Bank *bank)
{
    bank->head = NULL;
    bank->txStack.top = NULL;
    bank->txStack.count = 0;
    bank->txStack.nextId = 1;
    bank->queue.front = NULL;
    bank->queue.rear = NULL;
    bank->queue.size = 0;
    bank->queue.nextToken = 1;
    bank->nextAccNo = FIRST_ACC_NO;
}

int main(void)
{
    Bank bank;
    AccountNode *user;
    int choice;

    initBank(&bank);
    loadAccounts(&bank);
    loadTransactions(&bank.txStack);

    do {
        printf("\n========================================\n");
        printf("        BANKING MANAGEMENT SYSTEM\n");
        printf("========================================\n");
        printf("1. Customer Login\n");
