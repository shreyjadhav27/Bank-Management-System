/* Create a new account with a unique, automatically generated number */
static void createAccount(Bank *bank)
{
    Account acc;
    char pin1[PIN_LEN], pin2[PIN_LEN];
    int typeChoice;
    double deposit;
    AccountNode *node;

    memset(&acc, 0, sizeof acc);
    printf("\n--- Create New Account ---\n");
    readName("Customer name: ", acc.name);
    readPhone(acc.phone);
    readAddress(acc.address);

    printf("Account type: 1. Savings  2. Current\n");
    typeChoice = readInt("Enter choice: ", 1, 2);
    snprintf(acc.type, sizeof acc.type, "%s", typeChoice == 1 ? TYPE_SAVINGS : TYPE_CURRENT);

    while (1) {
        deposit = readAmount("Initial deposit: ");
        if (deposit >= MIN_INITIAL_DEPOSIT) {
            break;
        }
        printf("Initial deposit must be at least Rs %.2f.\n", MIN_INITIAL_DEPOSIT);
    }

    while (1) {
        readPin("Set a 4-digit PIN: ", pin1);
        readPin("Confirm PIN: ", pin2);
        if (strcmp(pin1, pin2) == 0) {
            break;
        }
        printf("PINs do not match. Try again.\n");
    }
    snprintf(acc.pin, sizeof acc.pin, "%s", pin1);

    /* generate a unique account number */
    while (findAccount(bank->head, bank->nextAccNo) != NULL) {
        bank->nextAccNo++;
    }
    acc.accNo = bank->nextAccNo++;
    acc.balance = deposit;
    acc.status = 1;

    node = insertAccount(bank, &acc);
    if (node == NULL) {
        printf("Account could not be created.\n");
        return;
    }
    pushTransaction(&bank->txStack, acc.accNo, "Account creation", deposit, acc.balance, 0);
    saveAll(bank);
    printf("\nAccount created successfully!\n");
    printf("Your account number is: %d (please remember it)\n", acc.accNo);
}

/* Customer login: returns the account node if credentials are correct */
static AccountNode *loginCustomer(Bank *bank)
{
    int attempt, accNo;
    char pin[PIN_LEN];
    AccountNode *node;

    printf("\n--- Customer Login ---\n");
    for (attempt = 1; attempt <= MAX_LOGIN_ATTEMPTS; attempt++) {
        accNo = readInt("Account number: ", FIRST_ACC_NO, MAX_ACC_NO);
        readPin("PIN: ", pin);
        node = findAccount(bank->head, accNo);
        if (node != NULL && strcmp(node->data.pin, pin) == 0) {
            if (!node->data.status) {
                printf("This account is blocked. Please contact the bank.\n");
                return NULL;
            }
            printf("Login successful. Welcome, %s!\n", node->data.name);
            return node;
        }
        printf("Wrong account number or PIN. (Attempt %d of %d)\n", attempt, MAX_LOGIN_ATTEMPTS);
    }
    printf("Too many failed attempts. Returning to main menu.\n");
    return NULL;
}

static void checkBalance(const AccountNode *user)
{
    printf("\nAvailable balance: Rs %.2f\n", user->data.balance);
}

static void depositMoney(Bank *bank, AccountNode *user)
{
    double amount = readAmount("Amount to deposit: ");
    user->data.balance += amount;
    pushTransaction(&bank->txStack, user->data.accNo, "Deposit", amount, user->data.balance, 0);
    saveAll(bank);
    printf("Rs %.2f deposited. New balance: Rs %.2f\n", amount, user->data.balance);
}

static void withdrawMoney(Bank *bank, AccountNode *user)
{
    double amount = readAmount("Amount to withdraw: ");
    if (amount > user->data.balance) {
        printf("Insufficient balance. Available: Rs %.2f\n", user->data.balance);
        return;
    }
    user->data.balance -= amount;
    pushTransaction(&bank->txStack, user->data.accNo, "Withdrawal", amount, user->data.balance, 0);
    saveAll(bank);
    printf("Rs %.2f withdrawn. New balance: Rs %.2f\n", amount, user->data.balance);
}

/* Transfer from the logged-in (sender) account to another account */
static void transferMoney(Bank *bank, AccountNode *sender)
{
    int receiverNo;
    double amount;
    AccountNode *receiver;

    printf("\n--- Transfer Money ---\n");
    printf("Sender account   : %d\n", sender->data.accNo);
    receiverNo = readInt("Receiver account number: ", FIRST_ACC_NO, MAX_ACC_NO);

    if (receiverNo == sender->data.accNo) {
        printf("You cannot transfer money to your own account.\n");
        return;
    }
    receiver = findAccount(bank->head, receiverNo);
    if (receiver == NULL) {
        printf("Receiver account does not exist. Transfer cancelled.\n");
        return;
    }
    if (!receiver->data.status) {
        printf("Receiver account is blocked. Transfer cancelled.\n");
        return;
    }
    amount = readAmount("Amount to transfer: ");
    if (amount > sender->data.balance) {
        printf("Insufficient balance. Available: Rs %.2f\n", sender->data.balance);
        return;
    }

    sender->data.balance -= amount;
    receiver->data.balance += amount;
    pushTransaction(&bank->txStack, sender->data.accNo, "Transfer Out", amount,
                    sender->data.balance, receiverNo);
    pushTransaction(&bank->txStack, receiver->data.accNo, "Transfer In", amount,
                    receiver->data.balance, sender->data.accNo);
    saveAll(bank);
    printf("Rs %.2f transferred to account %d (%s).\n", amount, receiverNo, receiver->data.name);
    printf("Your new balance: Rs %.2f\n", sender->data.balance);
}

static void changePin(Bank *bank, AccountNode *user)
{
    char oldPin[PIN_LEN], newPin1[PIN_LEN], newPin2[PIN_LEN];

    readPin("Enter current PIN: ", oldPin);
    if (strcmp(oldPin, user->data.pin) != 0) {
        printf("Incorrect current PIN.\n");
        return;
    }
    readPin("Enter new 4-digit PIN: ", newPin1);
    readPin("Confirm new PIN: ", newPin2);
    if (strcmp(newPin1, newPin2) != 0) {
        printf("PINs do not match. PIN not changed.\n");
        return;
    }
    snprintf(user->data.pin, sizeof user->data.pin, "%s", newPin1);
    saveAll(bank);
    printf("PIN changed successfully.\n");
}

/* Menu shown after a successful customer login */
static void customerMenu(Bank *bank, AccountNode *user)
{
    int choice;
    do {
        printf("\n---------- CUSTOMER MENU ----------\n");
        printf("Logged in: %s (Account %d)\n\n", user->data.name, user->data.accNo);
        printf("1. Check Balance\n");
        printf("2. Deposit Money\n");
        printf("3. Withdraw Money\n");
        printf("4. Transfer Money\n");
        printf("5. Transaction History\n");
        printf("6. Account Details\n");
        printf("7. Change PIN\n");
        printf("8. Logout\n");
        choice = readInt("Enter choice: ", 1, 8);

        switch (choice) {
        case 1: checkBalance(user); break;
        case 2: depositMoney(bank, user); break;
        case 3: withdrawMoney(bank, user); break;
        case 4: transferMoney(bank, user); break;
        case 5:
            printf("\n--- Transaction History (newest first) ---\n");
            displayTransactions(&bank->txStack, user->data.accNo, 0);
            break;
        case 6: displayAccountDetails(&user->data); break;
        case 7: changePin(bank, user); break;
        case 8: printf("Logged out successfully.\n"); break;
        }
    } while (choice != 8);
}

