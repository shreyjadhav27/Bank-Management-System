/* ---------------------- Constants ---------------------- */
#define ADMIN_USER "admin"
#define ADMIN_PASS "admin123"
#define ACCOUNTS_FILE "accounts.dat"
#define TRANSACTIONS_FILE "transactions.dat"

#define NAME_LEN 50
#define PHONE_LEN 11 /* 10 digits + '\0' */
#define ADDR_LEN 80
#define TYPE_LEN 10
#define PIN_LEN 5 /* 4 digits + '\0' */
#define TX_TYPE_LEN 20
#define TIME_LEN 20
#define SERVICE_LEN 30
#define INPUT_LEN 100

#define FIRST_ACC_NO 1001
#define MAX_ACC_NO 999999
#define MIN_INITIAL_DEPOSIT 500.0
#define MAX_AMOUNT 1000000000.0
#define MAX_LOGIN_ATTEMPTS 3

#define TYPE_SAVINGS "Savings"
#define TYPE_CURRENT "Current"

#define SORT_BY_ACCNO 1
#define SORT_BY_NAME 2
#define SORT_BY_BALANCE 3

/* ---------------------- Structures ---------------------- */

/* One bank account (customer information) */
typedef struct {
    int accNo;
    char name[NAME_LEN];
    char phone[PHONE_LEN];
    char address[ADDR_LEN];
    char type[TYPE_LEN]; /* "Savings" or "Current" */
    double balance;
    char pin[PIN_LEN];   /* 4-digit PIN stored as text */
    int status;          /* 1 = Active, 0 = Blocked */
} Account;

/* LINKED LIST NODE: account data + pointer to next account */
typedef struct AccountNode {
    Account data;
    struct AccountNode *next;
} AccountNode;

/* One transaction record */
typedef struct {
    int id;
    int accNo;
    char type[TX_TYPE_LEN]; /* Deposit, Withdrawal, Transfer Out, ... */
    double amount;
    char dateTime[TIME_LEN];
    double balanceAfter;
    int otherAcc; /* other account in a transfer, 0 if none */
} Transaction;

/* STACK NODE: transaction + pointer to the node below it */
typedef struct TxNode {
    Transaction data;
    struct TxNode *next;
} TxNode;

/* STACK: 'top' always points to the newest transaction (LIFO) */
typedef struct {
    TxNode *top;
    int count;
    int nextId;
} TxStack;

/* QUEUE NODE: a customer waiting for service */
typedef struct QueueNode {
    int token;
    char name[NAME_LEN];
    char service[SERVICE_LEN];
    struct QueueNode *next;
} QueueNode;

/* QUEUE: remove from 'front', add at 'rear' (FIFO) */
typedef struct {
    QueueNode *front;
    QueueNode *rear;
    int size;
    int nextToken;
} Queue;

/* Whole bank state, passed to functions (avoids global variables) */
typedef struct {
    AccountNode *head; /* head of the accounts linked list */
    TxStack txStack;
    Queue queue;
    int nextAccNo;
} Bank;

