static int adminLogin(void)
{
    char user[INPUT_LEN], pass[INPUT_LEN];
    int attempt;

    printf("\n--- Admin Login ---\n");
    for (attempt = 1; attempt <= MAX_LOGIN_ATTEMPTS; attempt++) {
        readLine("Username: ", user, sizeof user);
        readLine("Password: ", pass, sizeof pass);
        if (strcmp(user, ADMIN_USER) == 0 && strcmp(pass, ADMIN_PASS) == 0) {
            printf("Admin login successful.\n");
            return 1;
        }
        printf("Wrong username or password. (Attempt %d of %d)\n", attempt, MAX_LOGIN_ATTEMPTS);
    }
    printf("Too many failed attempts. Returning to main menu.\n");
    return 0;
}

static void deleteAccount(Bank *bank)
{
    int accNo;
    AccountNode *node;

    accNo = readInt("Account number to delete: ", FIRST_ACC_NO, MAX_ACC_NO);
    node = findAccount(bank->head, accNo);
    if (node == NULL) {
        printf("Account %d not found.\n", accNo);
        return;
    }
    printAccountHeader();
    printAccountRow(&node->data);
    if (!readYesNo("Are you sure you want to delete this account? (y/n): ")) {
        printf("Deletion cancelled.\n");
        return;
    }
    if (deleteAccountNode(bank, accNo)) {
        saveAll(bank);
        printf("Account %d deleted.\n", accNo);
    }
}

static void updateAccount(Bank *bank)
{
    int accNo, choice;
    AccountNode *node;

    accNo = readInt("Account number to update: ", FIRST_ACC_NO, MAX_ACC_NO);
    node = findAccount(bank->head, accNo);
    if (node == NULL) {
        printf("Account %d not found.\n", accNo);
        return;
    }
    printf("\nUpdating account of %s\n", node->data.name);
    printf("1. Change name\n2. Change phone number\n3. Change address\n");
    printf("4. Block / Activate account\n5. Cancel\n");
    choice = readInt("Enter choice: ", 1, 5);

    switch (choice) {
    case 1: readName("New name: ", node->data.name); break;
    case 2: readPhone(node->data.phone); break;
    case 3: readAddress(node->data.address); break;
    case 4:
        node->data.status = !node->data.status;
        printf("Account is now %s.\n", node->data.status ? "Active" : "Blocked");
        break;
    default: return;
    }
    saveAll(bank);
    printf("Account updated.\n");
}

/* Admin sorting menu */
static void sortAccountsMenu(Bank *bank)
{
    int key, order;
    const char *keyName[] = {"", "account number", "customer name", "balance"};

    if (bank->head == NULL) {
        printf("No accounts to sort.\n");
        return;
    }
    printf("\n--- Sort Accounts ---\n");
    printf("1. By account number\n2. By customer name\n3. By balance\n");
    key = readInt("Sort by: ", 1, 3);
    printf("1. Ascending\n2. Descending\n");
    order = readInt("Order: ", 1, 2);

    if (sortAccounts(bank, key, order == 1)) {
        printf("\nAccounts sorted by %s (%s) using Bubble Sort:\n",
               keyName[key], order == 1 ? "ascending" : "descending");
        displayAccounts(bank);
        printf("[Bubble Sort time complexity: O(n^2) worst/average, O(n) best case]\n");
        saveAccounts(bank);
    }
}

static void manageQueue(Bank *bank)
{
    int choice, service;
    char name[NAME_LEN];
    const char *services[] = {"", "Cash Deposit", "Cash Withdrawal", "Account Opening", "General Enquiry"};

    do {
        printf("\n--- Customer Queue (FIFO) ---\n");
        printf("1. Add customer to queue\n2. Serve next customer\n");
        printf("3. Display waiting queue\n4. Back\n");
        choice = readInt("Enter choice: ", 1, 4);
        if (choice == 1) {
            readName("Customer name: ", name);
            printf("Service: 1. Cash Deposit  2. Cash Withdrawal  3. Account Opening  4. General Enquiry\n");
            service = readInt("Enter choice: ", 1, 4);
            addToQueue(&bank->queue, name, services[service]);
        } else if (choice == 2) {
            serveQueue(&bank->queue);
        } else if (choice == 3) {
            displayQueue(&bank->queue);
        }
    } while (choice != 4);
}

/* Bank statistics calculated from the stored accounts */
static void bankStatistics(const Bank *bank)
{
    const AccountNode *cur, *highest = NULL, *lowest = NULL;
    int total = 0, savings = 0, current = 0;
    double sum = 0.0;

    for (cur = bank->head; cur != NULL; cur = cur->next) {
        total++;
        sum += cur->data.balance;
        if (strcmp(cur->data.type, TYPE_SAVINGS) == 0) {
            savings++;
        } else {
            current++;
        }
        if (highest == NULL || cur->data.balance > highest->data.balance) {
            highest = cur;
        }
        if (lowest == NULL || cur->data.balance < lowest->data.balance) {
            lowest = cur;
        }
    }

    printf("\n----------- BANK STATISTICS -----------\n");
    printf("Total number of accounts : %d\n", total);
    printf("Total bank balance       : Rs %.2f\n", sum);
    printf("Savings accounts         : %d\n", savings);
    printf("Current accounts         : %d\n", current);
    if (total > 0) {
        printf("Highest balance          : Rs %.2f (Acc %d, %s)\n",
               highest->data.balance, highest->data.accNo, highest->data.name);
        printf("Lowest balance           : Rs %.2f (Acc %d, %s)\n",
               lowest->data.balance, lowest->data.accNo, lowest->data.name);
    } else {
        printf("Highest / lowest balance : N/A (no accounts)\n");
    }
}

