/* Remove leading and trailing spaces from a string */
static void trimString(char *s)
{
    size_t start = 0, len;
    while (s[start] != '\0' && isspace((unsigned char)s[start])) {
        start++;
    }
    if (start > 0) {
        memmove(s, s + start, strlen(s + start) + 1);
    }
    len = strlen(s);
    while (len > 0 && isspace((unsigned char)s[len - 1])) {
        s[--len] = '\0';
    }
}

/* Safely read one line of text (never overflows the buffer).
 * If input ends (Ctrl+D / Ctrl+Z) the program exits; all data is
 * already saved after every operation, so nothing is lost. */
static void readLine(const char *prompt, char *buf, int size)
{
    size_t len;
    printf("%s", prompt);
    if (fgets(buf, size, stdin) == NULL) {
        printf("\nInput closed. Exiting program.\n");
        exit(0);
    }
    len = strlen(buf);
    if (len > 0 && buf[len - 1] == '\n') {
        buf[len - 1] = '\0';
    } else {
        int ch; /* line was too long: throw away the rest of it */
        while ((ch = getchar()) != '\n' && ch != EOF) {
        }
    }
    trimString(buf);
}

/* Read an integer between min and max (keeps asking until valid) */
static int readInt(const char *prompt, int min, int max)
{
    char buf[INPUT_LEN];
    char *end;
    long value;
    while (1) {
        readLine(prompt, buf, sizeof buf);
        value = strtol(buf, &end, 10);
        if (buf[0] != '\0' && *end == '\0' && value >= min && value <= max) {
            return (int)value;
        }
        printf("Invalid input. Please enter a number between %d and %d.\n", min, max);
    }
}

/* Returns 1 if text is a positive-looking amount: digits, optional '.',
 * at most 2 decimal places. Rejects "-5", "abc", "1e5", "nan" etc. */
static int isValidAmountText(const char *s)
{
    int dots = 0, digits = 0, decimals = 0;
    if (*s == '\0') {
        return 0;
    }
    for (; *s != '\0'; s++) {
        if (*s == '.') {
            if (++dots > 1) {
                return 0;
            }
        } else if (isdigit((unsigned char)*s)) {
            digits++;
            if (dots) {
                decimals++;
            }
        } else {
            return 0;
        }
    }
    return digits > 0 && decimals <= 2;
}

/* Read a money amount greater than zero */
static double readAmount(const char *prompt)
{
    char buf[INPUT_LEN];
    double value;
    while (1) {
        readLine(prompt, buf, sizeof buf);
        if (isValidAmountText(buf)) {
            value = strtod(buf, NULL);
            if (value > 0.0 && value <= MAX_AMOUNT) {
                return value;
            }
        }
        printf("Invalid amount. Enter a positive number (max 2 decimals, below %.0f).\n", MAX_AMOUNT);
    }
}

/* Returns 1 if every character of s is a digit */
static int isAllDigits(const char *s)
{
    if (*s == '\0') {
        return 0;
    }
    for (; *s != '\0'; s++) {
        if (!isdigit((unsigned char)*s)) {
            return 0;
        }
    }
    return 1;
}

/* Read a 10-digit phone number */
static void readPhone(char *phone)
{
    char buf[INPUT_LEN];
    while (1) {
        readLine("Phone number (10 digits): ", buf, sizeof buf);
        if (strlen(buf) == 10 && isAllDigits(buf)) {
            strcpy(phone, buf); /* length already checked */
            return;
        }
        printf("Invalid phone number. It must contain exactly 10 digits.\n");
    }
}

/* Read a 4-digit PIN */
static void readPin(const char *prompt, char *pin)
{
    char buf[INPUT_LEN];
    while (1) {
        readLine(prompt, buf, sizeof buf);
        if (strlen(buf) == 4 && isAllDigits(buf)) {
            strcpy(pin, buf); /* length already checked */
            return;
        }
        printf("Invalid PIN. It must be exactly 4 digits.\n");
    }
}

/* Read a name (letters and spaces only) */
static void readName(const char *prompt, char *name)
{
    char buf[INPUT_LEN];
    size_t i;
    int ok;
    while (1) {
        readLine(prompt, buf, sizeof buf);
        ok = (buf[0] != '\0' && strlen(buf) < NAME_LEN);
        for (i = 0; ok && buf[i] != '\0'; i++) {
            if (!isalpha((unsigned char)buf[i]) && buf[i] != ' ') {
                ok = 0;
            }
        }
        if (ok) {
            strcpy(name, buf); /* length already checked */
            return;
        }
        printf("Invalid name. Use letters and spaces only (max %d characters).\n", NAME_LEN - 1);
    }
}

/* Read a non-empty address */
static void readAddress(char *address)
{
    char buf[INPUT_LEN];
    while (1) {
        readLine("Address: ", buf, sizeof buf);
        if (buf[0] != '\0' && strlen(buf) < ADDR_LEN) {
            strcpy(address, buf); /* length already checked */
            return;
        }
        printf("Invalid address. It cannot be empty (max %d characters).\n", ADDR_LEN - 1);
    }
}

/* Ask a yes/no question; returns 1 for yes, 0 for no */
static int readYesNo(const char *prompt)
{
    char buf[INPUT_LEN];
    while (1) {
        readLine(prompt, buf, sizeof buf);
        if (buf[0] == 'y' || buf[0] == 'Y') {
            return 1;
        }
        if (buf[0] == 'n' || buf[0] == 'N') {
            return 0;
        }
        printf("Please type y or n.\n");
    }
}

/* Get current date and time as text: YYYY-MM-DD HH:MM:SS */
static void getCurrentTime(char *out, size_t size)
{
    time_t now = time(NULL);
    struct tm *t = localtime(&now);
    if (t != NULL) {
        strftime(out, size, "%Y-%m-%d %H:%M:%S", t);
    } else {
        snprintf(out, size, "unknown");
    }
}

/* ====================================================== */
/*          LINKED LIST OPERATIONS (ACCOUNTS)              */
/* ====================================================== */

/* SEARCH in linked list by account number: walk node by node. O(n) */
static AccountNode *findAccount(AccountNode *head, int accNo)
{
    AccountNode *cur = head;
    while (cur != NULL) {
        if (cur->data.accNo == accNo) {
            return cur;
        }
        cur = cur->next;
    }
    return NULL;
}

/* INSERT a new account at the END of the linked list. O(n)
 * Returns the new node, or NULL if the account number already exists
 * (prevents duplicates) or memory is not available. */
static AccountNode *insertAccount(Bank *bank, const Account *acc)
{
    AccountNode *node, *cur;

    if (findAccount(bank->head, acc->accNo) != NULL) {
        return NULL; /* duplicate account number */
    }
    node = (AccountNode *)malloc(sizeof(AccountNode));
    if (node == NULL) {
        printf("Error: out of memory.\n");
        return NULL;
    }
    node->data = *acc;
    node->next = NULL;

    if (bank->head == NULL) {
        bank->head = node; /* first node */
    } else {
        cur = bank->head;
        while (cur->next != NULL) {
            cur = cur->next;
        }
        cur->next = node; /* attach at the end */
    }
    return node;
}

/* DELETE the node with the given account number. O(n)
 * 'prev' remembers the node before 'cur' so we can skip over 'cur'. */
static int deleteAccountNode(Bank *bank, int accNo)
{
    AccountNode *cur = bank->head;
    AccountNode *prev = NULL;

    while (cur != NULL && cur->data.accNo != accNo) {
        prev = cur;
        cur = cur->next;
    }
    if (cur == NULL) {
        return 0; /* not found */
    }
    if (prev == NULL) {
        bank->head = cur->next; /* deleting the first node */
    } else {
        prev->next = cur->next;
    }
    free(cur);
    return 1;
}

